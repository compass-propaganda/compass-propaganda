{
  "name": "compass-propaganda-feedback",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "predev": "node prepare.mjs",
    "dev": "wrangler dev --env local",
    "test": "node prepare.mjs && wrangler deploy --env='' --dry-run --outdir ../dist/feedback && node --test test/*.test.mjs",
    "check": "node prepare.mjs && wrangler deploy --env='' --dry-run",
    "deploy": "node prepare.mjs && wrangler deploy --env=''",
    "deploy:pages": "wrangler pages deploy --cwd pages --branch main",
    "types": "wrangler types"
  },
  "devDependencies": {
    "wrangler": "4.129.0",
    "miniflare": "5.20260903.0-alpha"
  }
}
